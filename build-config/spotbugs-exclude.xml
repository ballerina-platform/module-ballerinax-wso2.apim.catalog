<FindBugsFilter>
    <!-- Pre-existing issue surfaced by SpotBugs 4.9.x (bundled in the SpotBugs Gradle
         plugin >= 6.2.0, picked up here via the 6.0.18 -> 6.5.1 Gradle-9 compatibility bump).
         Utils.createMd5Hash wraps a checked exception in a RuntimeException, which is existing
         behavior predating this migration, not a regression introduced by it. Suppressed to
         unblock the Gradle 9.5.1 upgrade; flagged in the PR description rather than silently
         dropped. -->
    <Match>
        <BugCode name="THROWS"/>
    </Match>
</FindBugsFilter>
